.env.*
!.env.example
!.env.template
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.pubxml
*.pubxml.user
secrets.json
appsettings.*.local.json
appsettings.Secrets.json
appsettings.local.json

