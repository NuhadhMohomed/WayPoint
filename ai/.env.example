# WayPoint AI Microservice Environment Configuration
# Copy this file to .env and fill in your values
# Security Fix 05: Do not put real secrets or credentials in this file

# Environment (development, staging, production)
ENVIRONMENT=development

# ASP.NET Core Backend API Base URL
API_BASE_URL=http://localhost:5010/api/v1

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Service-to-Service API Key (mandatory in production/staging)
AI_SERVICE_API_KEY=your_ai_service_api_key_here

# Google Gemini API Key (mandatory in production/staging)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0.1

# AI Service Account (for authenticated backend tool calls)
# Enforce least-privilege: use account with Operator role, never Admin
AI_SERVICE_EMAIL=ai-service@waypoint.lk
AI_SERVICE_PASSWORD=your_ai_service_password_here

# Backend Origin for CORS restriction
BACKEND_ORIGIN=http://localhost:5010

# Execution Guardrails
AI_EXECUTION_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3
HTTP_TIMEOUT_SECONDS=8
